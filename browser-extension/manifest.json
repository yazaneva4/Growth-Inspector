{
  "manifest_version": 3,
  "name": "GrowthSpace Browser Bridge",
  "version": "0.1.0",
  "description": "Admin-controlled browser bridge for GrowthSpace.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://growthspace-ksa.vercel.app/*",
    "https://growthspace.sa/*",
    "https://*.growthspace.sa/*",
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "https://web.whatsapp.com/*",
    "https://messages.google.com/*",
    "https://growth-inspector.vercel.app/*"
  ],
  "action": {
    "default_title": "GrowthSpace",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://growthspace-ksa.vercel.app/*",
        "https://growthspace.sa/*",
        "https://*.growthspace.sa/*",
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://web.whatsapp.com/*",
        "https://messages.google.com/*",
        "https://growth-inspector.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
